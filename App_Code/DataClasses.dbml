<?xml version="1.0" encoding="utf-8"?><Database Name="nairuthya_db" Class="DataClassesDataContext" xmlns="http://schemas.microsoft.com/linqtosql/dbml/2007">
  <Table Name="dbo.Admin" Member="Admins">
    <Type Name="Admin">
      <Column Name="password" Type="System.String" DbType="VarChar(50)" CanBeNull="true" />
