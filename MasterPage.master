 <meta property="og:description"
     content="Trade with Knowledge. Grow with Confidence. Join AGS's expert-backed community for trading success.">
 <meta property="og:type" content="website">
 <link rel="icon" type="image/png" href="public/WhatsApp_Image_2025-07-20_at_12.27.41_AM-removebg-preview.png">
