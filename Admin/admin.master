    <!-- CORE TEMPLATE JS - START -->
    <script src="../member/assets/js/scripts.js"></script>
    <!-- Sidebar Collapse -->
    <script>
    document.addEventListener('DOMContentLoaded', () => {
        const menuToggle = document.getElementById("menuToggle");
        const menuItems = document.getElementById("menuItems");

        const isMobile = () => window.innerWidth <= 767;

        menuToggle.addEventListener('click', (e) => {
            e.preventDefault();

            if(isMobile()) {
                if(menuItems.style.display === 'block') {
                menuItems.style.display = 'none';
                } else {
                    menuItems.style.display = 'block';
                }
            }
         });

         // Ensure the menu is reset based on the device when the page loads
            const setInitialMenuState = () => {
                if (isMobile()) {
                menuItems.style.display = 'none'; // Hide menu for mobile devices
                } else {
                menuItems.style.display = 'flex'; // Show menu for desktop devices
                }
            };

            // Reset the menu visibility on resize
            window.addEventListener('resize', setInitialMenuState);

            // Set the initial menu state when the page loads
            setInitialMenuState();


    });

    </script>
