<%@ Page Title="Export" Language="C#" MasterPageFile="~/Admin/admin.master" AutoEventWireup="true"
    CodeFile="mem-export.aspx.cs" Inherits="Admin_mem_export" %>

<asp:Content ID="Content1" ContentPlaceHolderID="head" runat="Server">
    <style type="text/css">


.Grid {background-color: #fff; margin: 5px 0px 10px 10px; 
border: solid 1px #525252; border-collapse:collapse; color: #474747;
}
table{border-collapse:collapse;border-spacing:0; } 

table {
  border-collapse: collapse;
  border-spacing: 0;
}

a { color: #0070A6; }
	
a { color:#323232; text-decoration:none; }
a

{
  text-decoration:none;

}

.HeaderStyle, .PagerStyle /*Common Styles*/
{
   
    background-position:center;
    background-repeat:repeat-x;
    background-color:#0a4775;
	border-bottom:solid 1px #999;
	
}
        .style1
        {
            width: 98%;
            border-collapse: collapse;
            font-size: 100%;
            vertical-align: baseline;
            border-style: none;
            border-color: inherit;
            border-width: 0;
            margin: 0;
            padding: 0;
        }
        .style2
        {
            font-size: 100%;
            vertical-align: baseline;
            border-style: none;
            border-color: inherit;
            border-width: 0;
            margin: 0;
            padding: 0;
        }
        .style3
        {
            font-size: 100%;
            vertical-align: baseline;
            font-weight: normal;
            font-family: OpenSansRegular;
            border-style: none;
            border-color: inherit;
            border-width: 0;
            margin: 0;
            padding: 0;
            background:;
        }
        .style4
        {
            width: 140px;
            font-size: 100%;
            vertical-align: baseline;
            border-style: none;
            border-color: inherit;
            border-width: 0;
            margin: 0;
            padding: 0;
        }
    </style>
</asp:Content>
<asp:Content ID="Content2" ContentPlaceHolderID="ContentPlaceHolder1" runat="Server">
    <div>
        <asp:GridView ID="GridView1" runat="server" AutoGenerateColumns="False" CssClass="Grid"
            PagerStyle-CssClass="PagerStyle" DataKeyNames="username" Width="60%">
            <Columns>
                <asp:TemplateField>
                    <HeaderTemplate>
                        SNo</HeaderTemplate>
                    <ItemTemplate>
                        <asp:Label ID="lblSRNO" runat="server" Text='<%#Container.DataItemIndex+1 %>'></asp:Label>
                    </ItemTemplate>
                </asp:TemplateField>
                <asp:BoundField DataField="username" HeaderText="ID" ItemStyle-HorizontalAlign="Left"
                    ReadOnly="True" SortExpression="username">
                    <ItemStyle HorizontalAlign="Left"></ItemStyle>
                </asp:BoundField>
                <asp:BoundField DataField="name" HeaderText="Name" ItemStyle-HorizontalAlign="Left"
                    SortExpression="name">
                    <ItemStyle HorizontalAlign="Left"></ItemStyle>
                </asp:BoundField>
                <asp:BoundField DataField="mobile" HeaderText="Mobile" SortExpression="mobile" />
                <asp:BoundField DataField="plan" HeaderText="Plan" SortExpression="plan" />
                <asp:BoundField DataField="joindate" HeaderText="Join Date" ItemStyle-HorizontalAlign="Left"
                    ItemStyle-Width="80px" DataFormatString="{0:dd/MMM/yyyy }" SortExpression="joindate">
                    <ItemStyle HorizontalAlign="Left" Width="80px"></ItemStyle>
                </asp:BoundField>
                  <asp:BoundField DataField="renewal" HeaderText="Activation Date" ItemStyle-HorizontalAlign="Left"
                    ItemStyle-Width="80px" DataFormatString="{0:dd/MMM/yyyy }" SortExpression="joindate">
                    <ItemStyle HorizontalAlign="Left" Width="80px"></ItemStyle>
                </asp:BoundField>
              
                <asp:BoundField DataField="account" HeaderText="Acc No" SortExpression="plan" />
                <asp:BoundField DataField="ifsc" HeaderText="IFSC" SortExpression="plan" />
            </Columns>
        </asp:GridView>
    </div>
</asp:Content>
